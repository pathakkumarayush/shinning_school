	"item": [
		{
			"name": "1. Teacher Module",
			"item": [
				{
					"name": "Get Teachers (with ID, Login UID & Password)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/get_teacher.php?session={{session}}",
							"host": ["{{base_url}}"],
							"path": ["get_teacher.php"],
							"query": [
								{ "key": "session", "value": "{{session}}" },
								{ "key": "id", "value": "", "disabled": true },
								{ "key": "teacher_id", "value": "", "disabled": true },
								{ "key": "status", "value": "1", "disabled": true }
							]
						},
						"description": "Fetches all teachers including database primary `id` (int), `teacher_id` (int), `login_uid` (`login.uid`), `login_password` (`login.pass`), and `teacher_type`."
					}
				},
				{
					"name": "Get Profile",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/get_profile.php?user_id=techshining23&session={{session}}",
							"host": ["{{base_url}}"],
							"path": ["get_profile.php"],
							"query": [
								{ "key": "user_id", "value": "techshining23" },
								{ "key": "session", "value": "{{session}}" }
							]
						}
					}
				}
			]
		},
		{
			"name": "2. Syllabus Module (Role-Based Access Control)",
			"item": [
				{
