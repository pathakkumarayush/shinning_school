							"host": ["{{base_url}}"],
							"path": ["syllabus", "store_syllabus.php"]
						},
						"description": "Enforces assignment check against `class_teacher_sub` for Subject Teachers (denies unassigned classes/subjects with HTTP 403). Admins have full access."
					}
				},
